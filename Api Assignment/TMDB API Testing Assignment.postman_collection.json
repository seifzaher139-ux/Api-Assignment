    {
      "name": "S01 - Search Movies by Keyword",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData = pm.response.json();\r",
              "const keyword = \"inception\";\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains a non-empty results array\", function () {\r",
              "    pm.expect(responseData).to.have.property(\"results\");\r",
              "    pm.expect(responseData.results).to.be.an(\"array\").that.is.not.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Each movie contains the required fields\", function () {\r",
              "    responseData.results.forEach(function (movie) {\r",
              "        pm.expect(movie).to.have.property(\"id\");\r",
              "        pm.expect(movie).to.have.property(\"title\");\r",
              "        pm.expect(movie).to.have.property(\"release_date\");\r",
              "        pm.expect(movie).to.have.property(\"overview\");\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"At least one movie title matches the search keyword\", function () {\r",
              "    const matchingMovie = responseData.results.some(function (movie) {\r",
              "        return movie.title.toLowerCase().includes(keyword);\r",
              "    });\r",
              "    pm.expect(matchingMovie).to.be.true;\r",
              "});\r",
              "\r",
              "pm.test(\"Total results is greater than zero\", function () {\r",
              "    pm.expect(responseData.total_results).to.be.a(\"number\");\r",
              "    pm.expect(responseData.total_results).to.be.above(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/search/movie?query=inception&language=en-US",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "search",
            "movie"
          ],
          "query": [
            {
              "key": "query",
              "value": "inception"
            },
            {
              "key": "language",
